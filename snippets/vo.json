{
    "class": {
        "prefix": ["class"],
        "body": [
            "---@class ${1:name}",
            "local ${1:name} = {}",
            "${1:name}.__index = ${1:name}",
            "${1:name}.__class = \"${1:name}\"",
            "",
            "function ${1:name}.New()",
            "\tlocal self = setmetatable({}, ${1:name})",
            "",
            "\t$0",
            "",
            "\treturn self",
            "end",
            "",
            "function ${1:name}:__tostring()",
            "\treturn \"<${1:name}>\"",
            "end",
            "",
            "return ${1:name}"
        ],
        "description": "New lua 'class'"
    },
    "ui_class": {
        "prefix": ["uiclass"],
        "body": [
            "local UiBox = require(\"UiBox\")",
            "",
            "local lg = love.graphics",
            "",
            "local ASSETS = {}",
            "",
            "---@class ${1:name}",
            "---@field private _ui_box UiBox",
            "local ${1:name} = {}",
            "${1:name}.__index = ${1:name}",
            "${1:name}.__class = \"${1:name}\"",
            "${1:name}.__preloaded = false",
            "",
            "function ${1:name}.PreloadAssets()",
            "    if ${1:name}.__preloaded then",
            "        return",
            "    end",
            "",
            "    ${1:name}.__preloaded = true",
            "end",
            "",
            "function ${1:name}.New()",
            "    local self = setmetatable({}, ${1:name})",
            "",
            "    ${1:name}.PreloadAssets()",
            "",
            "    $0",
            "",
            "    self._ui_box = UiBox.New(width, height)",
            "        :setOwner(self)",
            "        :on(\"update\", self.onUpdate, self)",
            "",
            "    return self",
            "end",
            "",
            "function ${1:name}:__tostring()",
            "    return \"<${1:name}>\"",
            "end",
            "",
            "---@return UiBox",
            "function ${1:name}:getUiBox()",
            "    return self._ui_box",
            "end",
            "",
            "function ${1:name}:onUpdate(_, dt)",
            "end",
            "",
            "function ${1:name}:onUiBoxDraw(_, x, y, w, h)",
            "end",
            "",
            "return ${1:name}"
        ]
    }
}
